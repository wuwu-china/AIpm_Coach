{
  "name": "aipm-coach",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "AIPMCoach · AI 产品经理六维能力自适应测评（简化版 CAT + 雷达图 + BYOK AI 弱点诊断）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
